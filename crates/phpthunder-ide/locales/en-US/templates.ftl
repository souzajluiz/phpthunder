# Live template descriptions, shown in the ⌘J list.
# Keys: template-<abbreviation>, lowercase kebab-case.

template-pubf = public method
template-prof = protected method
template-prif = private method
template-pubsf = public static method
template-construct = constructor
template-fore = foreach over values
template-forek = foreach over keys and values
template-for = counting for loop
template-if = if block
template-ife = if/else block
template-try = try/catch block
template-fn = arrow function
template-func = closure
template-match = match expression
template-thr = throw an exception
template-dd = dump and die (Laravel)
template-dump = dump a value
template-vd = var_dump
template-it = Pest test
template-test = PHPUnit test method
template-rel = Eloquent relationship
